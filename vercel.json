{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://*.clarity.ms; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.clarity.ms https://c.bing.com https://www.google-analytics.com https://www.googletagmanager.com https://*.google.com https://*.gstatic.com; font-src 'self' data:; connect-src 'self' https://*.clarity.ms https://c.bing.com https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://www.googletagmanager.com; frame-src https://www.google.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; worker-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "framework": null,
  "buildCommand": "node --test tests/*.test.cjs && node scripts/build-site.mjs && node scripts/check-site.mjs",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home2.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/material.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<materialId>pana-panne|pana-thor|pana-hulk|pana-velutti|pana-velvet|lino-boucle-largo|lino-dot|lino-mecha|lino-spazio|lino-scandal|cuerina-dakota|cuerina-legards|cuerina-marbella|cuerina-nebraska|cuero-vacuno-mantra|cuero-vacuno-novapelli|cuero-vacuno-riviera|cuero-vacuno-stragrain|sheep)"
        }
      ],
      "destination": "/materiales/:materialId.html",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<productId>silla-nordica-lino|banqueta-canelon|cabecera-curva|almohadon-premium|sillon-curvo|respaldo-botones)"
        }
      ],
      "destination": "/productos/:productId.html",
      "permanent": true
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/home2-leads.js": {
      "maxDuration": 20
    }
  }
}
